# Frontend (Vite)
VITE_MERCADOPAGO_PUBLIC_KEY=your_public_key_here
VITE_API_URL=your_api_gateway_url_here
VITE_CLARITY_PROJECT_ID=your_clarity_project_id_here

# Legacy (si tienes scripts antiguos basados en CRA)
REACT_APP_MERCADOPAGO_PUBLIC_KEY=your_public_key_here
REACT_APP_API_URL=your_api_url_here

# Supabase (para productos)
VITE_SUPABASE_URL=https://xpjzcitdcnreisjgscov.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Chat Provider: "zoho" o "custom"
# custom = usa el widget personalizado (chat-widget.js)
# zoho = usa el chat de Zoho SalesIQ
VITE_CHAT_PROVIDER=custom

# URL del API Gateway de AWS para el chatbot
# Ejemplo: https://abc123xyz.execute-api.us-east-1.amazonaws.com/prod
VITE_CHAT_API_URL=https://TU-API-GATEWAY-URL.execute-api.REGION.amazonaws.com/prod

# URL del API Gateway para subir comprobantes de pago (Lambda → S3)
VITE_RECEIPTS_API_URL=https://TU-API-GATEWAY-RECEIPTS.execute-api.REGION.amazonaws.com

# Webhook de Make.com para notificar nuevas órdenes a Zoho (opcional)
VITE_MAKE_ORDER_WEBHOOK_URL=https://hook.us2.make.com/TU-WEBHOOK-ID

# Recargo y descuento por método de pago (opcionales)
# 0.04 = 4%
VITE_MP_COMMISSION_RATE=0.04
VITE_TRANSFER_DISCOUNT_RATE=0.04

# Tarifas de envio (opcionales)
VITE_FREE_SHIPPING_THRESHOLD=1000
VITE_SHIPPING_RATE_LOCAL=90
VITE_SHIPPING_RATE_REGIONAL=150
VITE_SHIPPING_RATE_NATIONAL=220
VITE_SHIPPING_RATE_EXTENDED=320